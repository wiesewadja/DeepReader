{
  "name": "obsidian-deepreader",
  "version": "0.9.1",
  "description": "DeepReader - 深度阅读插件",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run copy-css && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "copy-css": "node scripts/build-css.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "deploy": "npm run build && mkdir -p \"/Users/lizhao/workspace/deepreadertest/.obsidian/plugins/deepreader\" && cp main.js manifest.json styles.css \"/Users/lizhao/workspace/deepreadertest/.obsidian/plugins/deepreader/\""
  },
  "keywords": [
    "obsidian",
    "pdf",
    "epub",
    "knowledge",
    "search"
  ],
  "author": "DeepReader Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.0.0",
    "@vitest/ui": "^1.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.0",
    "jsdom": "^27.4.0",
    "obsidian": "latest",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0"
  }
}
