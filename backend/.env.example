# DeepPDF API 配置模板
#
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 填入你的 API Key
# 3. 不要将 .env 文件提交到 Git 仓库

# ==================== LLM API 配置 ====================

# DeepSeek API Key（从 https://platform.deepseek.com/api_keys 获取）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 或者使用 OpenAI API（二选一）
# OPENAI_API_KEY=your_openai_api_key_here

# 或者使用 Google API
# GOOGLE_API_KEY=your_google_api_key_here

# 或者使用 Anthropic API
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 自定义 API Base URL（使用自定义 provider 时必填）
# LLM_BASE_URL=https://api.example.com/v1

# ==================== PDF 索引配置 ====================

# LLM Provider（deepseek/openai/google/custom/anthropic）
PDF_INDEX_LLM_PROVIDER=deepseek

# LLM Model 名称
PDF_INDEX_MODEL=deepseek-chat

# 目录检测页数（前 N 页检测目录结构）
PDF_INDEX_TOC_CHECK_PAGES=20

# 每个节点最大页数
PDF_INDEX_MAX_PAGES_PER_NODE=10

# 每个节点最大 token 数
PDF_INDEX_MAX_TOKENS_PER_NODE=20000

# 是否添加节点摘要（使用 LLM）
PDF_INDEX_IF_ADD_NODE_SUMMARY=yes

# 是否添加节点原文
PDF_INDEX_IF_ADD_NODE_TEXT=no

# 是否添加文档描述
PDF_INDEX_IF_ADD_DOC_DESCRIPTION=no

# ==================== 查询配置 ====================

# 语义搜索返回的最大结果数
DEEPPDF_MAX_RESULTS=5

# ==================== 并发配置 ====================

# CPU 密集型任务线程数
CPU_WORKERS=2

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=10

# LLM 并发限制
LLM_CONCURRENT_LIMIT=3

# ==================== 服务器配置 ====================

# API 端口
API_PORT=6088

# 数据存储目录
BASE_DIR=data
