# DeepReader API 配置模板
#
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 填入你的 API Key
# 3. 不要将 .env 文件提交到 Git 仓库

# ============================================================
# LLM API Keys 配置
# ============================================================
# 多 Provider 并行模式需要配置多个 API Key

# DeepSeek API Key（从 https://platform.deepseek.com/api_keys 获取）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# SiliconFlow API Key（从 https://cloud.siliconflow.cn 获取）
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 智谱 API Key（从 https://open.bigmodel.cn 获取）
# ZHIPU_API_KEY=your_zhipu_api_key_here

# 其他可选 Provider
# OPENAI_API_KEY=your_openai_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# PDF 索引配置
# ============================================================

# 目录检测页数（前 N 页检测目录结构）
PDF_INDEX_TOC_CHECK_PAGES=20

# 每个节点最大页数
PDF_INDEX_MAX_PAGES_PER_NODE=10

# 每个节点最大 token 数
PDF_INDEX_MAX_TOKENS_PER_NODE=20000

# 是否添加节点摘要（使用 LLM，耗时较长）
PDF_INDEX_IF_ADD_NODE_SUMMARY=yes

# 是否添加节点原文
PDF_INDEX_IF_ADD_NODE_TEXT=yes

# 是否添加文档描述
PDF_INDEX_IF_ADD_DOC_DESCRIPTION=yes

# 是否用 LLM 格式化文本（耗时较长）
PDF_INDEX_FORMAT_TEXT_WITH_LLM=yes

# ============================================================
# 并发配置
# ============================================================

# LLM 并发限制（多 Provider 模式下建议设为 Provider 数量的 3-5 倍）
LLM_CONCURRENT_LIMIT=10

# CPU 密集型任务线程数
CPU_WORKERS=2

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=10

# ============================================================
# 服务器配置
# ============================================================

# API 端口
API_PORT=6088

# 数据存储目录
BASE_DIR=data
