# DeepPDF Backend Dockerfile - Slim Version (No OCR)
# This version excludes PaddleOCR/PaddlePaddle to reduce image size
# ~3-4GB smaller than the full version

FROM python:3.11-slim-bookworm AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy workspace configuration
COPY pyproject.toml uv.lock ./
COPY pageindex-lib/ ./pageindex-lib/
COPY deeppdf-api/ ./deeppdf-api/

# Modify pyproject.toml to exclude paddle dependencies
# We'll use sed to remove paddle dependencies before installing
RUN sed -i '/paddle/d' pageindex-lib/pyproject.toml && \
    sed -i '/paddle/d' pyproject.toml

# Update uv.lock to reflect changes
RUN rm uv.lock && uv lock

# Install dependencies with no cache
ENV UV_NO_CACHE=1
RUN uv sync --frozen --no-dev && \
    rm -rf /root/.cache/uv /app/.venv/share/doc /app/.venv/share/man

# Production stage
FROM python:3.11-slim-bookworm AS production

# Install minimal runtime dependencies (no OpenCV/libGL needed without OCR)
RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && rm -rf /usr/share/doc /usr/share/man /usr/share/info

# Create non-root user
RUN useradd --create-home --shell /bin/bash app

WORKDIR /app

# Copy virtual environment
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY --from=builder /app/deeppdf-api/src/ ./deeppdf-api/src/
COPY --from=builder /app/pageindex-lib/src/ ./pageindex-lib/src/

# Set environment variables
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/deeppdf-api/src:/app/pageindex-lib/src" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    UVICORN_HOST=0.0.0.0 \
    UVICORN_PORT=5088 \
    UVICORN_LOOP=asyncio \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Disable OCR functionality
    DISABLE_OCR=1

# Create directories
RUN mkdir -p /app/data /app/logs && chown -R app:app /app

USER app

EXPOSE 5088

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5088/health')" || exit 1

CMD ["uvicorn", "deeppdf.main:app", "--host", "0.0.0.0", "--port", "5088", "--loop", "asyncio"]
