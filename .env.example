# ============================================================
# DeepReader 环境变量示例
# 复制为 .env 后填入真实值:  cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交
#
# deploy 时自动注入 test-vault 的 data.json
# e2e-light / eval 测试也会读取这些值
# ============================================================

# ----- LLM Provider API Keys -----
# 至少配置 roles 中使用的 provider 的 key
DEEPREADER_XIAOMI_API_KEY=
DEEPREADER_XIAOMI_FALLBACK_KEY=
DEEPREADER_SILICONFLOW_API_KEY=
# DEEPREADER_OPENAI_API_KEY=
# DEEPREADER_DEEPSEEK_API_KEY=
# DEEPREADER_MINIMAX_API_KEY=
# DEEPREADER_KIMI_API_KEY=
# DEEPREADER_ZHIPU_API_KEY=
# DEEPREADER_SENSENOVA_API_KEY=
# DEEPREADER_MINERU_API_KEY=
# DEEPREADER_CUSTOM_BASE_URL=
# DEEPREADER_CUSTOM_API_KEY=
# DEEPREADER_CUSTOM_NAME=

# ----- LLM Roles -----
# 格式: provider/model（留空使用默认值）
DEEPREADER_ROLE_CHAT=xiaomi/mimo-v2.5-pro
DEEPREADER_ROLE_ROUTER=xiaomi/mimo-v2.5
DEEPREADER_ROLE_PAGEINDEX=xiaomi/mimo-v2.5
DEEPREADER_ROLE_PROPOSITION=xiaomi/mimo-v2.5
DEEPREADER_ROLE_EMBEDDING=siliconflow/Qwen/Qwen3-Embedding-0.6B
DEEPREADER_ROLE_RERANKER=siliconflow/Qwen/Qwen3-Reranker-0.6B
DEEPREADER_ROLE_TTS=xiaomi/mimo-v2.5-tts-voicedesign
DEEPREADER_ROLE_IMAGEGEN=sensenova/sensenova-u1-fast

# ----- 微信读书 -----
# DEEPREADER_WEREAD_API_KEY=
# DEEPREADER_WEREAD_SYNC_INTERVAL=0
# DEEPREADER_WEREAD_EXCLUDE_ARTICLES=true
# DEEPREADER_WEREAD_NOTE_THRESHOLD=1

# ----- Z-Library -----
# DEEPREADER_ZLIBRARY_ENABLED=false
# DEEPREADER_ZLIBRARY_USER_ID=
# DEEPREADER_ZLIBRARY_USER_KEY=
# DEEPREADER_ZLIBRARY_DOMAIN=

# ----- PI Coding Agent -----
# DEEPREADER_PI_ENABLED=false
# DEEPREADER_PI_CUSTOM_PATH=
# PI_BIN=/opt/homebrew/bin/pi
# PI_PROVIDER=xiaomi-token-plan-cn
# PI_MODEL=mimo-v2.5

# ----- LangSmith -----
# DEEPREADER_LANGSMITH_API_KEY=
# DEEPREADER_LANGSMITH_PROJECT=DeepReader
# DEEPREADER_LANGSMITH_ENABLED=false

# ----- Langfuse -----
# DEEPREADER_LANGFUSE_PUBLIC_KEY=
# DEEPREADER_LANGFUSE_SECRET_KEY=
# DEEPREADER_LANGFUSE_BASE_URL=http://localhost:3000
# DEEPREADER_LANGFUSE_ENABLED=false

# ----- E2E / Eval 测试 -----
# EVAL_BOOK=反脆弱
# OBSIDIAN_CLI=obsidian-cli

# ----- 插件行为 -----
# DEEPREADER_API_PORT=6088
# DEEPREADER_MAX_RESULTS=5
# DEEPREADER_RERANKER_WEIGHT=0.7
# DEEPREADER_FORCE_MODE=auto
# DEEPREADER_AUTO_READING_MODE=true
# DEEPREADER_READING_MODE_STYLE=paginated
# DEEPREADER_MESSAGE_THEME=kami
# DEEPREADER_ENABLE_DEBUG_LOG=false
# DEEPREADER_PROACTIVE_GUIDANCE=true
# DEEPREADER_PROACTIVE_COOLDOWN=5
# DEEPREADER_JOURNAL_DIR=
# DEEPREADER_SETUP_COMPLETE=false
