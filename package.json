{
  "name": "obsidian-deepreader",
  "version": "2026.06.23",
  "description": "奚童 - 深度AI伴读",
  "main": "bin/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run build:check && npm run build:bundle",
    "build:check": "npm run sync-version && npm run copy-css && tsc -noEmit -skipLibCheck",
    "build:bundle": "node esbuild.config.mjs production",
    "sync-version": "node scripts/sync-version.js",
    "copy-css": "node scripts/build-css.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "arch-guard": "node scripts/arch-guard.mjs",
    "arch-guard:strict": "node scripts/arch-guard.mjs --strict",
    "e2e-cdp": "node tests/e2e-cdp/run.mjs",
    "e2e-cli": "node tests/e2e-cli/run.mjs",
    "deploy": "node scripts/deploy.js dev && node scripts/inject-config.mjs",
    "deploy:dev": "node scripts/deploy.js dev && node scripts/inject-config.mjs",
    "deploy:daily": "node scripts/deploy.js daily",
    "deploy:all": "node scripts/deploy.js dev daily && node scripts/inject-config.mjs",
    "verify-deploy": "node scripts/verify-deploy.mjs",
    "eval": "node scripts/eval/eval-cli.mjs",
    "eval:generate": "node scripts/eval/eval-cli.mjs generate",
    "eval:run": "node scripts/eval/eval-cli.mjs run",
    "eval:judge": "node scripts/eval/eval-cli.mjs judge",
    "eval:history": "node scripts/eval/eval-cli.mjs history",
    "eval:diff": "node scripts/eval/eval-cli.mjs diff",
    "eval:full": "node scripts/eval/eval-cli.mjs full",
    "eval:sync-prompts": "rsync -av scripts/eval/eval-prompts/ test-vault/.eval/",
    "smoke": "node scripts/smoke/smoke.mjs",
    "smoke:core": "node scripts/smoke/smoke.mjs --level core",
    "smoke:full": "node scripts/smoke/smoke.mjs --level full",
    "smoke:verbose": "node scripts/smoke/smoke.mjs --verbose",
    "e2e-light": "node scripts/e2e-light/run.mjs",
    "e2e-light:verbose": "node scripts/e2e-light/run.mjs --verbose",
    "worktree:create": "bash scripts/setup-worktree.sh"
  },
  "keywords": [
    "obsidian",
    "pdf",
    "epub",
    "knowledge",
    "search"
  ],
  "author": "昭见森",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wiesewadja/DeepReader.git"
  },
  "bugs": {
    "url": "https://github.com/wiesewadja/DeepReader/issues"
  },
  "homepage": "https://github.com/wiesewadja/DeepReader",
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/jsdom": "^27.0.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/ui": "^1.0.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^27.4.0",
    "obsidian": "latest",
    "ts-node": "^10.9.2",
    "turndown": "^7.2.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^1.0.0",
    "wdio-obsidian-service": "^3.0.3",
    "webdriverio": "^9.27.2",
    "xml2js": "^0.6.2"
  },
  "dependencies": {
    "@langchain/core": "^1.1.40",
    "@langchain/langgraph": "^1.2.8",
    "@langchain/langgraph-checkpoint": "^1.0.1",
    "@langchain/openai": "^1.4.4",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@opentelemetry/sdk-trace-web": "^2.6.1",
    "@types/nunjucks": "^3.2.6",
    "adm-zip": "^0.5.17",
    "langsmith": "^0.5.20",
    "lz-string": "^1.5.0",
    "node-html-markdown": "^1.3.0",
    "nunjucks": "^3.2.4",
    "pdf-lib": "^1.17.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
}