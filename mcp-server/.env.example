# API Key for LLM providers
# 支持 OPENAI_API_KEY 或 CHATGPT_API_KEY（向后兼容）
#
# 对于 DeepSeek: 从 https://platform.deepseek.com/api_keys 获取
# 对于 OpenAI: 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=your_api_key_here

# 向后兼容：如果设置 CHATGPT_API_KEY，它会覆盖 OPENAI_API_KEY
# CHATGPT_API_KEY=your_api_key_here
