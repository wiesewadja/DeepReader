# ============================================================
# LLM API 配置
# ============================================================

# API Key for LLM providers
# 支持 OPENAI_API_KEY、CHATGPT_API_KEY 或 DEEPSEEK_API_KEY
#
# 对于 DeepSeek: 从 https://platform.deepseek.com/api_keys 获取
# 对于 OpenAI: 从 https://platform.openai.com/api-keys 获取
DEEPSEEK_API_KEY=sk-3415c913c2674c69ba67e4e52ae2cdf5
OPENAI_API_KEY=

# 向后兼容：如果设置 CHATGPT_API_KEY，它会覆盖 OPENAI_API_KEY
# CHATGPT_API_KEY=your_api_key_here

# ============================================================
# PDF 索引配置（PageIndex 默认参数）
# ============================================================

# LLM Provider 类型（deepseek, openai, google, custom）
PDF_INDEX_LLM_PROVIDER=deepseek

# 使用的模型名称
PDF_INDEX_MODEL=deepseek-chat

# API Base URL（可选，用于自定义端点）
# PDF_INDEX_BASE_URL=

# 检查目录的页数
PDF_INDEX_TOC_CHECK_PAGES=20

# 每个节点最大页数
PDF_INDEX_MAX_PAGES_PER_NODE=10

# 每个节点最大 token 数
PDF_INDEX_MAX_TOKENS_PER_NODE=20000

# 是否添加节点 ID（yes/no）
PDF_INDEX_IF_ADD_NODE_ID=yes

# 是否添加摘要（yes/no）
PDF_INDEX_IF_ADD_NODE_SUMMARY=yes

# 是否添加文本内容（yes/no）
# 注意：向量化优先使用 summary，如果没有则使用 text
PDF_INDEX_IF_ADD_NODE_TEXT=no

# 是否添加文档描述（yes/no）
PDF_INDEX_IF_ADD_DOC_DESCRIPTION=no

# ============================================================
# 示例命令
# ============================================================

# cd /Users/lizhao/workspace/DeepPDF/mcp-server && .venv/bin/python scripts/run_pageindex.py \
#   --pdf_path "data/纳瓦尔宝典.pdf" \
#   --llm-provider deepseek \
#   --api-key "sk-3415c913c2674c69ba67e4e52ae2cdf5" \
#   --model "deepseek-chat" \
#   --if-add-node-summary yes \
#   --if-add-node-id yes